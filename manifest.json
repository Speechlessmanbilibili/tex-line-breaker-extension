{
  "manifest_version": 3,
  "name": "TeX Line Breaker",
  "version": "0.3.1",
  "key": "",
  "description": "TeX/Knuth-Plass paragraph line breaking with CJK microtypography for Chromium.",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["hyphenation-en-us.js", "shared.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "TeX Line Breaker", "default_popup": "popup.html" },
  "web_accessible_resources": [{
    "resources": ["wasm/tex_line_breaker_core.wasm"],
    "matches": ["<all_urls>"]
  }]
}
